# ==============================================================================
# AVELUNE Django Backend — Environment Configuration Template (.env.example)
# Copy this file to .env and provide your specific credentials.
# ==============================================================================

# Django Core
DJANGO_SECRET_KEY=your-secret-key-change-in-production
DEBUG=True
ALLOWED_HOSTS=127.0.0.1,localhost

# CORS Allowed Origins
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Database
DATABASE_NAME=db.sqlite3

# Razorpay Payment Gateway (Test / Live Credentials)
RAZORPAY_KEY_ID=your_razorpay_key_id_here
RAZORPAY_KEY_SECRET=your_razorpay_key_secret_here
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret_here

# Google Gemini API
GEMINI_API_KEY=your_gemini_api_key_here

# Google OAuth 2.0 Credentials
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here
GOOGLE_REDIRECT_URI=http://localhost:5173/auth/google/callback

# SMTP Email Configuration (Gmail Delivery)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=ayushkumar53467@gmail.com
DEFAULT_FROM_EMAIL=ayushkumar53467@gmail.com
# Set your 16-character Google App Password from https://myaccount.google.com/apppasswords
EMAIL_HOST_PASSWORD=your_gmail_app_password_here
